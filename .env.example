# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VAULT_ENCRYPTION_KEY: Secret passphrase or 32-byte hex (>= 16 chars) for encrypting exchange API keys at rest.
# Required in production (NODE_ENV=production or VERCEL_ENV=production) before storing/reading Vault credentials.
VAULT_ENCRYPTION_KEY=""

# OMNISENT_ADMIN_TOKEN: Optional bearer/header token protecting mutating, execution, and Vault endpoints when set.
OMNISENT_ADMIN_TOKEN=""

# ALLOWED_ORIGIN: Optional explicit CORS origin allowlist (comma-separated URLs) for production deployments.
ALLOWED_ORIGIN=""

# OMNISENT_DATA_DIR: Optional custom directory path for SQLite database storage (defaults to ./.data or OS tmp).
OMNISENT_DATA_DIR=""
