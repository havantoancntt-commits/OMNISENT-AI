# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VAULT_ENCRYPTION_KEY: Secret passphrase or 32-byte hex (>= 16 chars) for encrypting exchange API keys at rest.
# Required in strict production (NODE_ENV=production or VERCEL_ENV=production) unless ALLOW_UNAUTH_DEV=1.
VAULT_ENCRYPTION_KEY=""

# RBAC Bearer / X-Admin-Token Secrets (timing-safe verified; OMNISENT_ADMIN_TOKEN grants SYSTEM_ADMIN):
OMNISENT_ADMIN_TOKEN=""
OMNISENT_TRADER_TOKEN=""
OMNISENT_RISK_TOKEN=""
OMNISENT_EXCHANGE_TOKEN=""

# DEV ONLY: Explicit opt-in to bypass strict production startup auth/vault guard (NEVER set to 1 in real production)
ALLOW_UNAUTH_DEV=""

# LIVE EXCHANGE EXECUTION SAFETY SWITCH: Must remain "false" unless institutional exchange custody & approval are complete
OMNISENT_LIVE_EXECUTION_ENABLED="false"

# ALLOWED_ORIGIN: Explicit CORS origin allowlist (comma-separated URLs) for production deployments
ALLOWED_ORIGIN=""
ALLOW_CLOUD_RUN_CORS="0"

# DATABASE_URL: Optional PostgreSQL connection string for multi-instance production persistence (SQLite WAL used locally)
DATABASE_URL=""
OMNISENT_DATA_DIR=""

# REDIS_URL / Upstash REST: Optional distributed sliding-window rate limiting & lock store (in-memory fallback locally)
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Operational Guardrails
AI_MAX_CALLS_PER_HOUR="120"
AI_MAX_CONCURRENT="3"
REQUEST_TIMEOUT_MS="25000"

